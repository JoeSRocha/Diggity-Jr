{
  "name": "adroit/diggity-jr",
  "description": "Diggityjr.com Website Dependencies",
  "repositories":[
    {
      "type": "package",
      "package": {
        "name": "payment-intelligence/payment-intelligence",
        "version": "0.1.0",
        "type": "wordpress-plugin",
        "license": "GPL-2.0-or-later",
        "source": {
          "type": "git",
          "url": "git@github.com:JoeSRocha/payment-intelligence-for-woocommerce.git",
          "reference": "1fba48424d28eed7547be8c1280a36780f6874dc"
        },
        "require": {
          "php": ">=7.4",
          "composer/installers": "^2.3"
        }
      }
    },
    {
      "type":"composer",
      "url":"https://wpackagist.org"
    }
  ],
  "require": {
    "payment-intelligence/payment-intelligence": "0.1.0",
    "wpackagist-plugin/classic-editor":"^1.7.0",
    "wpackagist-plugin/contact-form-7":"^6.1.7",
    "wpackagist-plugin/ewww-image-optimizer":"^8.7.7",
    "wpackagist-plugin/instock-email-alert-for-woocommerce":"^1.1.4",
    "wpackagist-plugin/jetpack":"^16.1.3",
    "wpackagist-plugin/log-emails":"^1.6.0",
    "wpackagist-plugin/printful-shipping-for-woocommerce":"^2.2.12",
    "wpackagist-plugin/pymntpl-paypal-woocommerce":"2.0.26",
    "wpackagist-plugin/woocommerce":"^11.1.0",
    "wpackagist-plugin/woocommerce-services":"^3.6.14",
    "vlucas/phpdotenv": "^4.1.0",
    "wpackagist-plugin/wp-mail-smtp": "^4.9.0"
  },
  "require-dev": {
    "wpackagist-plugin/disable-emails":"^1.8.3"
  },
  "extra": {
    "installer-paths": {
      "wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
      "wp-content/themes/{$name}/": ["type:wordpress-theme"]
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
