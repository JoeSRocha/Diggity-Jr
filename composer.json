{
  "name": "adroit/diggity-jr",
  "description": "Diggityjr.com Website Dependencies",
  "repositories":[
    {
      "type": "package",
      "package": {
        "name": "payment-intelligence/payment-intelligence",
        "version": "0.1.0",
        "type": "wordpress-plugin",
        "license": "GPL-2.0-or-later",
        "source": {
          "type": "git",
          "url": "git@github.com:JoeSRocha/payment-intelligence-for-woocommerce.git",
          "reference": "1fba48424d28eed7547be8c1280a36780f6874dc"
        },
        "require": {
          "php": ">=7.4",
          "composer/installers": "^2.3"
        }
      }
    },
    {
      "type":"composer",
      "url":"https://wpackagist.org"
    }
  ],
  "require": {
    "payment-intelligence/payment-intelligence": "*",
    "wpackagist-plugin/classic-editor":"*",
    "wpackagist-plugin/contact-form-7":"*",
    "wpackagist-plugin/ewww-image-optimizer":"*",
    "wpackagist-plugin/google-site-kit": "*",
    "wpackagist-plugin/instock-email-alert-for-woocommerce":"*",
    "wpackagist-plugin/jetpack":"*",
    "wpackagist-plugin/log-emails":"*",
    "wpackagist-plugin/printful-shipping-for-woocommerce":"*",
    "wpackagist-plugin/pymntpl-paypal-woocommerce":"^2.0",
    "wpackagist-plugin/woocommerce":"*",
    "wpackagist-plugin/woocommerce-services":"*",
    "vlucas/phpdotenv": "*",
    "wpackagist-plugin/wp-mail-smtp": "*"
  },
  "require-dev": {
    "wpackagist-plugin/disable-emails":"*"
  },
  "extra": {
    "installer-paths": {
      "wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
      "wp-content/themes/{$name}/": ["type:wordpress-theme"]
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
